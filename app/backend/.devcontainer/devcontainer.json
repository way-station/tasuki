{
  "name": "tasuki backend (Go)",
  "dockerComposeFile": [
    "../../../infra/compose.yaml",
    "../../../infra/compose.dev.yaml"
  ],
  "service": "backend-dev",
  "runServices": ["mongo", "backend-dev"],
  "workspaceFolder": "/workspaces/tasuki/app/backend",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"],
      "settings": {
        "go.toolsManagement.autoUpdate": false,
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--fast-only"]
      }
    }
  }
}
